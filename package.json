{
    "name": "text2struct",
    "version": "0.1.2",
    "description": "Convert plain-text lists into structured data.",
    "type": "module",
    "main": "./src/index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./src/index.js"
        },
        "./sqlite": {
            "types": "./sqlite.d.ts",
            "import": "./src/sqlite.js"
        }
    },
    "bin": {
        "text2struct": "bin/text2struct.js"
    },
    "files": [
        "bin",
        "src",
        "index.d.ts",
        "sqlite.d.ts",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage",
        "npm:whoami": "npm whoami --registry=https://registry.npmjs.org/",
        "prepublishOnly": "npm run npm:whoami && npm test",
        "publish:dry": "npm publish --dry-run --access public",
        "publish:npm": "npm publish --access public"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "text",
        "parser",
        "csv",
        "json",
        "yaml",
        "sqlite",
        "cli"
    ],
    "license": "MIT"
}
